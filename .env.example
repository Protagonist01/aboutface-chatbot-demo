# about-face Chatbot - Environment Variables
# Copy to .env and fill in your keys

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
CHAT_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,qwen/qwen3-next-80b-a3b-instruct:free
CHAT_TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=300

PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=about-face-kb
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_CANDIDATE_K=15
PINECONE_TOP_K=5
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

PUBLIC_SITE_URL=https://your-demo-url.example
APP_NAME=about-face chatbot demo
PORT=3000

MAX_MESSAGE_LENGTH=800
MAX_HISTORY_ITEMS=6
IP_RATE_LIMIT_WINDOW_MS=60000
IP_RATE_LIMIT_MAX_REQUESTS=8
DAILY_GLOBAL_REQUEST_LIMIT=250
